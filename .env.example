# The public Netlify URL, without a trailing slash.
PUBLIC_BASE_URL=https://your-site.netlify.app

# Comma-separated WhatsApp group JIDs. Keep this file private after filling it.
# Example: 123456789012345678@g.us,987654321098765432@g.us
WHATSAPP_GROUP_JIDS=

# Keep session credentials and the delivery ledger outside the Git checkout on the VPS.
WHATSAPP_AUTH_DIR=/var/lib/prayerjournal/baileys-auth
WHATSAPP_LEDGER_FILE=/var/lib/prayerjournal/send-ledger.json
JOURNAL_TIMEZONE=Africa/Lagos
